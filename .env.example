# ── Email alerts ─────────────────────────────────────────────────────────────
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
ALERT_FROM_EMAIL=your_sender@gmail.com
ALERT_FROM_PASSWORD=your_16_char_app_password
ALERT_TO_EMAIL=your_personal@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Recreation.gov ────────────────────────────────────────────────────────────
# No API key needed for availability checks (public endpoint)
# RECGOV_API_KEY=

# ── Search window ─────────────────────────────────────────────────────────────
# How many weeks ahead to scan (rolling, from today)
LOOKAHEAD_WEEKS_MIN=1
LOOKAHEAD_WEEKS_MAX=24

# ── Scheduler ─────────────────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=15
# Extra-frequent check window (Thu+Fri, when release slots open up)
PEAK_INTERVAL_MINUTES=5
ACTIVE_HOURS_START=6
ACTIVE_HOURS_END=23

# ── Site requirements ─────────────────────────────────────────────────────────
MIN_SITE_LENGTH_FT=25
# true = electric or full hookup required; false = accept sites with dump station only
REQUIRE_HOOKUP=true
REQUIRE_DUMP_STATION=true
